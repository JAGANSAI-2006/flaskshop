# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# IBM watsonx.ai credentials
# Obtain from: IBM Cloud → Manage → Access (IAM) → API Keys
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# Obtain from: watsonx.ai → your Project → Manage → General → Project ID
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Regional endpoint — use the one matching your IBM Cloud region
# Dallas (us-south):  https://us-south.ml.cloud.ibm.com
# Frankfurt (eu-de):  https://eu-de.ml.cloud.ibm.com
# Tokyo (jp-tok):     https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com
